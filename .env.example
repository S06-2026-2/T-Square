# Copie este arquivo para .env na raiz do projeto: cp .env.example .env
# Estas variaveis alimentam o docker-compose.yml

# ---- Banco de dados ----
POSTGRES_USER=gesso
POSTGRES_PASSWORD=gesso
POSTGRES_DB=gesso
POSTGRES_PORT=5432

# ---- API ----
JWT_SECRET=troque-esse-segredo-em-producao
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# ---- Agente de estoque ----
# Chave da Claude API: deixe vazia aqui e preencha so no seu .env (nunca commitado).
# Sem chave, a analise roda so com a rede de seguranca (alertas basicos) e termina como FALHA.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# true liga a analise diaria das 06:00 e o catch-up ao subir a API; false desliga os dois
AGENTE_AUTOMATICO=false

# ---- Web ----
VITE_API_URL=http://localhost:3000
