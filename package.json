{
  "name": "gesso-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestao para firma de gesso - obras, gesseiros e estoque",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx,json,css}\"",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "db:studio": "npm run db:studio --workspace apps/api",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
